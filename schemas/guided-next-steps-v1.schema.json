{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/guided-next-steps-v1.schema.json",
  "title": "GEO Guided Next Steps V1",
  "type": "object",
  "required": [
    "guidance_version", "diagnostic_id", "company_id", "delivery_mode", "vertical_business",
    "current_stage", "recommended_next_stage", "next_prompt", "decision_required",
    "stages", "skill_recommendations", "optimization_directions", "keyword_review"
  ],
  "properties": {
    "guidance_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "delivery_mode": {"enum": ["简约版", "完整版"]},
    "vertical_business": {"type": "string", "minLength": 1},
    "current_stage": {"type": "string", "minLength": 1},
    "recommended_next_stage": {"type": "string", "minLength": 1},
    "next_prompt": {"type": "string", "minLength": 1},
    "decision_required": {"type": "boolean"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "name", "status", "prompt", "recommendation", "requires_user_confirmation"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["COMPLETE", "READY_FOR_REVIEW", "NEEDS_CONFIRMATION", "NOT_IN_SCOPE"]},
          "prompt": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "requires_user_confirmation": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "skill_recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill", "when", "reason", "next_decision"],
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "next_decision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "optimization_directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["priority", "title", "reason", "next_action", "status"],
        "properties": {
          "priority": {"enum": ["P0", "P1", "P2"]},
          "title": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "status": {"enum": ["READY", "NEEDS_CONFIRMATION", "NOT_IN_SCOPE"]}
        },
        "additionalProperties": false
      }
    },
    "keyword_review": {
      "type": "object",
      "required": ["client_requested", "approved", "excluded"],
      "properties": {
        "client_requested": {"type": "array", "items": {"type": "string"}},
        "approved": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
