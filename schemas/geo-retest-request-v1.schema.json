{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/geo-retest-request-v1.schema.json",
  "title": "GEO to GEO-BD Retest Request V1",
  "type": "object",
  "required": [
    "retest_version",
    "diagnostic_id",
    "company_id",
    "source_system",
    "target_system",
    "executed_prescription_ids",
    "executed_strategy_ids",
    "retest_targets"
  ],
  "properties": {
    "retest_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "source_system": {"const": "GEO"},
    "target_system": {"const": "GEO-BD"},
    "executed_prescription_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}
    },
    "executed_strategy_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^STRATEGY-.+$"}
    },
    "retest_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    }
  },
  "additionalProperties": false
}
