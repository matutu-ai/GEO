{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/persona-plan-v1.schema.json",
  "title": "GEO Nine Persona Plan V1",
  "type": "object",
  "required": ["persona_version", "diagnostic_id", "company_id", "personas"],
  "properties": {
    "persona_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "personas": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["persona_id", "name", "focus", "status", "confirmed_content", "unknown_content", "missing_materials", "forbidden_claims", "fact_ids", "prescription_ids", "strategy_ids"],
        "properties": {
          "persona_id": {"type": "string", "pattern": "^PERSONA-.+$"},
          "name": {"type": "string", "minLength": 1},
        "focus": {"type": "string", "minLength": 1},
        "status": {"enum": ["READY", "NOT_IMPLEMENTED"]},
        "confirmed_content": {"type": "array", "items": {"type": "string"}},
        "unknown_content": {"type": "array", "items": {"type": "string"}},
        "missing_materials": {"type": "array", "items": {"type": "string"}},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "prescription_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}
          },
          "strategy_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^STRATEGY-.+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
