{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/user-persona-plan-v1.schema.json",
  "title": "GEO User Decision Persona Plan V1",
  "type": "object",
  "required": ["user_persona_version", "diagnostic_id", "company_id", "personas"],
  "properties": {
    "user_persona_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "user_persona_id", "name", "audience", "scenario", "decision_stage",
          "pain_points", "decision_criteria", "query_patterns", "query_pattern_status",
          "status", "keyword_ids", "fact_ids", "prescription_ids", "strategy_ids"
        ],
        "properties": {
          "user_persona_id": {"type": "string", "pattern": "^USER-PERSONA-.+$"},
          "name": {"type": "string", "minLength": 1},
          "audience": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "decision_stage": {"type": "string", "minLength": 1},
          "pain_points": {"type": "array", "items": {"type": "string"}},
          "decision_criteria": {"type": "array", "items": {"type": "string"}},
          "query_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "query_pattern_status": {"enum": ["CLIENT_REQUESTED", "SYSTEM_RECOMMENDED", "MIXED"]},
          "status": {"enum": ["CONFIRMED", "NEEDS_CONFIRMATION"]},
          "keyword_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KEYWORD-.+$"}},
          "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
          "strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
