{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/execution-v1.schema.json",
  "title": "GEO Standard Execution Projection V1",
  "type": "object",
  "required": [
    "execution_version",
    "diagnostic_id",
    "company_id",
    "source_system",
    "prescriptions",
    "strategies",
    "intents",
    "keywords",
    "personas",
    "user_personas",
    "guided_next_steps",
    "evidence_readiness",
    "content_projection",
    "source_projection",
    "publishing_projection",
    "retest_request"
  ],
  "properties": {
    "execution_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "source_system": {"enum": ["GEO-BD", "MANUAL"]},
    "prescriptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prescription"}},
    "strategies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strategy"}},
    "intents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/intent"}},
    "keywords": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyword"}},
    "personas": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/persona"}},
    "user_personas": {"$ref": "#/$defs/userPersonaPlan"},
    "guided_next_steps": {"$ref": "#/$defs/guidedNextSteps"},
    "evidence_readiness": {"$ref": "#/$defs/evidenceReadiness"},
    "content_projection": {"$ref": "#/$defs/notImplemented"},
    "source_projection": {"$ref": "#/$defs/notImplemented"},
    "publishing_projection": {"$ref": "#/$defs/notImplemented"},
    "retest_request": {"$ref": "#/$defs/retestRequest"}
  },
  "additionalProperties": false,
  "$defs": {
    "prescription": {
      "type": "object",
      "required": ["id", "statement", "priority", "root_cause_ids", "expected_outcome", "verification_method", "handoff_to"],
      "properties": {
        "id": {"type": "string", "pattern": "^PRESCRIPTION-.+$"},
        "statement": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "pattern": "^P[0-9]+$"},
        "root_cause_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_outcome": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "handoff_to": {"const": "GEO"}
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": ["id", "prescription_ids", "objective", "priority", "execution_scope", "fact_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^STRATEGY-.+$"},
        "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "objective": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "pattern": "^P[0-9]+$"},
        "execution_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["keyword", "persona", "content", "source", "publishing", "retest"]}},
        "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": ["id", "strategy_ids", "prescription_ids", "intent", "scenario", "target_user", "fact_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^INTENT-.+$"},
        "strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}},
        "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "intent": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "target_user": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "keyword": {
      "type": "object",
      "required": ["keyword_id", "keyword", "keyword_type", "product_or_service", "user_scenario", "search_intent", "persona_unit", "fact_ids", "prescription_ids", "strategy_ids", "intent_ids", "evidence_status", "risk_level", "needs_confirmation"],
      "properties": {
        "keyword_id": {"type": "string", "pattern": "^KEYWORD-.+$"},
        "keyword": {"type": "string", "minLength": 1},
        "keyword_type": {"enum": ["品牌词", "搜索词", "问答词", "意图场景词"]},
        "product_or_service": {"type": "string", "minLength": 1},
        "user_scenario": {"type": "string", "minLength": 1},
        "search_intent": {"type": "string", "minLength": 1},
        "persona_unit": {"enum": ["产品或服务描述", "产品或服务特点", "品牌故事", "用户痛点", "信任背书", "客户案例", "社会贡献", "客户评价", "创始人介绍"]},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}},
        "intent_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^INTENT-.+$"}},
        "evidence_status": {"enum": ["CONFIRMED", "INFERRED", "UNKNOWN", "CONFLICTED"]},
        "risk_level": {"enum": ["低", "中", "高"]},
        "needs_confirmation": {"type": "boolean"},
        "keyword_origin": {"enum": ["CLIENT_REQUESTED", "SYSTEM_RECOMMENDED"]},
        "decision_status": {"enum": ["RECOMMENDED", "PENDING_CONFIRMATION", "CONFIRMED"]}
      },
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "required": ["persona_id", "name", "focus", "status", "confirmed_content", "unknown_content", "missing_materials", "forbidden_claims", "fact_ids", "prescription_ids", "strategy_ids"],
      "properties": {
        "persona_id": {"type": "string", "pattern": "^PERSONA-.+$"},
        "name": {"type": "string", "minLength": 1},
        "focus": {"type": "string", "minLength": 1},
        "status": {"enum": ["READY", "NOT_IMPLEMENTED"]},
        "confirmed_content": {"type": "array", "items": {"type": "string"}},
        "unknown_content": {"type": "array", "items": {"type": "string"}},
        "missing_materials": {"type": "array", "items": {"type": "string"}},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}}
      },
      "additionalProperties": false
    },
    "evidenceReadiness": {
      "type": "object",
      "required": ["status", "confirmed_fact_count", "total_fact_count", "missing_fact_fields", "fact_ids"],
      "properties": {
        "status": {"const": "REFERENCE_ONLY"},
        "confirmed_fact_count": {"type": "integer", "minimum": 0},
        "total_fact_count": {"type": "integer", "minimum": 1},
        "missing_fact_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "notImplemented": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"const": "NOT_IMPLEMENTED"}},
      "additionalProperties": false
    },
    "retestRequest": {
      "type": "object",
      "required": ["retest_version", "diagnostic_id", "company_id", "source_system", "target_system", "executed_prescription_ids", "executed_strategy_ids", "retest_targets"],
      "properties": {
        "retest_version": {"const": "1.0.0"},
        "diagnostic_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "source_system": {"const": "GEO"},
        "target_system": {"const": "GEO-BD"},
        "executed_prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "executed_strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}},
        "retest_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      },
      "additionalProperties": false
    },
    "userPersonaPlan": {
      "type": "object",
      "required": ["user_persona_version", "diagnostic_id", "company_id", "personas"],
      "properties": {
        "user_persona_version": {"const": "1.0.0"},
        "diagnostic_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "personas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/userPersona"}
        }
      },
      "additionalProperties": false
    },
    "userPersona": {
      "type": "object",
      "required": [
        "user_persona_id", "name", "audience", "scenario", "decision_stage",
        "pain_points", "decision_criteria", "query_patterns", "query_pattern_status",
        "status", "keyword_ids", "fact_ids", "prescription_ids", "strategy_ids"
      ],
      "properties": {
        "user_persona_id": {"type": "string", "pattern": "^USER-PERSONA-.+$"},
        "name": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "decision_stage": {"type": "string", "minLength": 1},
        "pain_points": {"type": "array", "items": {"type": "string"}},
        "decision_criteria": {"type": "array", "items": {"type": "string"}},
        "query_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "query_pattern_status": {"enum": ["CLIENT_REQUESTED", "SYSTEM_RECOMMENDED", "MIXED"]},
        "status": {"enum": ["CONFIRMED", "NEEDS_CONFIRMATION"]},
        "keyword_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KEYWORD-.+$"}},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prescription_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}},
        "strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^STRATEGY-.+$"}}
      },
      "additionalProperties": false
    },
    "guidedNextSteps": {
      "type": "object",
      "required": [
        "guidance_version", "diagnostic_id", "company_id", "delivery_mode", "vertical_business",
        "current_stage", "recommended_next_stage", "next_prompt", "decision_required",
        "stages", "skill_recommendations", "optimization_directions", "keyword_review"
      ],
      "properties": {
        "guidance_version": {"const": "1.0.0"},
        "diagnostic_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "delivery_mode": {"enum": ["简约版", "完整版"]},
        "vertical_business": {"type": "string", "minLength": 1},
        "current_stage": {"type": "string", "minLength": 1},
        "recommended_next_stage": {"type": "string", "minLength": 1},
        "next_prompt": {"type": "string", "minLength": 1},
        "decision_required": {"type": "boolean"},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/guidanceStage"}
        },
        "skill_recommendations": {
          "type": "array",
          "minItems": 1,
            "items": {"$ref": "#/$defs/skillRecommendation"}
        },
        "optimization_directions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/optimizationDirection"}
        },
        "keyword_review": {
          "type": "object",
          "required": ["client_requested", "approved", "excluded"],
          "properties": {
            "client_requested": {"type": "array", "items": {"type": "string"}},
            "approved": {"type": "array", "items": {"type": "string"}},
            "excluded": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "guidanceStage": {
      "type": "object",
      "required": ["stage_id", "name", "status", "prompt", "recommendation", "requires_user_confirmation"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETE", "READY_FOR_REVIEW", "NEEDS_CONFIRMATION", "NOT_IN_SCOPE"]},
        "prompt": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "requires_user_confirmation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "skillRecommendation": {
      "type": "object",
      "required": ["skill", "when", "reason", "next_decision"],
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "when": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "next_decision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "optimizationDirection": {
      "type": "object",
      "required": ["priority", "title", "reason", "next_action", "status"],
      "properties": {
        "priority": {"enum": ["P0", "P1", "P2"]},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "status": {"enum": ["READY", "NEEDS_CONFIRMATION", "NOT_IN_SCOPE"]}
      },
      "additionalProperties": false
    }
  }
}
