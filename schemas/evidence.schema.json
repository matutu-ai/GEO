{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "required": ["claim", "evidence_level", "verified"],
  "properties": {
    "claim": { "type": "string" },
    "source": { "type": "string" },
    "evidence_level": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "verified": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
