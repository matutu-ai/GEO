{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/geo-strategy-v1.schema.json",
  "title": "GEO Execution Strategy V1",
  "type": "object",
  "required": ["strategy_version", "diagnostic_id", "company_id", "strategies"],
  "properties": {
    "strategy_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prescription_ids",
          "objective",
          "priority",
          "execution_scope",
          "fact_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^STRATEGY-.+$"},
          "prescription_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^PRESCRIPTION-.+$"}
          },
          "objective": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "pattern": "^P[0-9]+$"},
          "execution_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["keyword", "persona", "content", "source", "publishing", "retest"]
            }
          },
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
