{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matutu-ai/GEO/schemas/geo-bd-handoff-v1.schema.json",
  "title": "GEO-BD to GEO Prescription Handoff V1",
  "type": "object",
  "required": [
    "handoff_version",
    "diagnostic_id",
    "company_id",
    "source_system",
    "target_system",
    "prescriptions"
  ],
  "properties": {
    "handoff_version": {"const": "1.0.0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "company_name": {"type": "string", "minLength": 1},
    "source_system": {"const": "GEO-BD"},
    "target_system": {"const": "GEO"},
    "prescriptions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/prescription"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "prescription": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "priority",
        "root_cause_ids",
        "expected_outcome",
        "verification_method",
        "handoff_to"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^PRESCRIPTION-.+$"},
        "statement": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "pattern": "^P[0-9]+$"},
        "root_cause_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_outcome": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "handoff_to": {"const": "GEO"}
      },
      "additionalProperties": false
    },
    "manualPrescriptionInput": {
      "type": "object",
      "required": [
        "handoff_version",
        "diagnostic_id",
        "company_id",
        "source_system",
        "target_system",
        "prescriptions"
      ],
      "properties": {
        "handoff_version": {"const": "1.0.0"},
        "diagnostic_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "source_system": {"const": "MANUAL"},
        "target_system": {"const": "GEO"},
        "prescriptions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/prescription"}
        }
      },
      "additionalProperties": false
    }
  }
}
